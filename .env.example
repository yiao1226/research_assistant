# LLM 配置
LLM_MODEL_ID=deepseek-v4-flash
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com

# 搜索配置（可选但推荐）
TAVILY_API_KEY=your-tavily-api-key-here
SERPAPI_API_KEY=...

# Qdrant 向量数据库（可选，默认本地文件存储）
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Neo4j 图数据库（可选，用于知识图谱）
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# HuggingFace 镜像（国内用户需要，解决下载超时问题）
HF_ENDPOINT=https://hf-mirror.com

# Embedding 配置（留空使用框架默认百炼API）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Web of Science API（可选，需要机构订阅）
WOS_API_KEY=

# Semantic Scholar API Key（免费申请 https://www.semanticscholar.org/product/api#api-key-form）
# 不填使用匿名访问（限流极严格，建议申请）
S2_API_KEY=
